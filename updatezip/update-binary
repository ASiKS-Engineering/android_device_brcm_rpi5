#!/system/bin/sh
#
# SPDX-License-Identifier: Apache-2.0
#
# Update-binary for the Raspberry Pi 5 AOSP update zip. It is executed by TWRP (recovery on
# the SD card) as: update-binary <api> <outfd> <zip>
#
# images.txt (generated by mkupdatezip.sh) lists "<file> <partition suffix> <bytes> <sha256>".
# /data and /metadata are never touched.

OUTFD="$2"
ZIP="$3"
DISK=/dev/block/nvme0n1
WORK=/tmp/rpi5_update

ui_print() {
  printf 'ui_print %s\nui_print\n' "$1" >> /proc/self/fd/"$OUTFD"
}

abort() {
  ui_print "ERROR: $1"
  ui_print "Update aborted."
  exit 1
}

mkdir -p "$WORK" && cd "$WORK" || abort "cannot create $WORK"
rm -f images.txt fingerprint.txt

# Which unzip can stream a single file to stdout?
UNZIP=
for U in "unzip" "busybox unzip" "toybox unzip"; do
  $U -o "$ZIP" images.txt fingerprint.txt >/dev/null 2>&1 || continue
  if [ "$($U -p "$ZIP" fingerprint.txt 2>/dev/null)" = "$(cat fingerprint.txt)" ]; then
    UNZIP="$U"
    break
  fi
done
[ -n "$UNZIP" ] || abort "no unzip with -p support found in recovery"
[ -s images.txt ] || abort "images.txt missing in zip"

ui_print "Raspberry Pi 5 AOSP update"
ui_print "New build: $(cat fingerprint.txt)"

[ -b "$DISK" ] || abort "$DISK not found (NVMe not detected)"

# Pass 1: check partitions and the integrity of the zip before anything is written.
while read -r file part size sha; do
  case "$file" in ''|'#'*) continue ;; esac
  dev="${DISK}${part}"
  [ -b "$dev" ] || abort "$dev not found"
  psize=$(( $(cat "/sys/class/block/${dev##*/}/size") * 512 ))
  [ "$psize" -ge "$size" ] || abort "$file ($size bytes) does not fit into $dev ($psize bytes)"
  ui_print "Checking $file ..."
  got=$($UNZIP -p "$ZIP" "$file" | sha256sum | cut -d' ' -f1)
  [ "$got" = "$sha" ] || abort "$file is corrupt (checksum mismatch)"
done < images.txt

# Release the partitions if TWRP mounted them.
grep "^/dev/block/nvme0n1p[156] " /proc/mounts | while read -r d mp rest; do
  umount "$mp" 2>/dev/null
done
if grep -q "^/dev/block/nvme0n1p[156] " /proc/mounts; then
  abort "a target partition is still mounted"
fi

# Pass 2: write and verify. boot goes last so that a failure leaves the old kernel/ramdisk.
for want in vendor.img system.img boot.img; do
  while read -r file part size sha; do
    [ "$file" = "$want" ] || continue
    dev="${DISK}${part}"
    ui_print "Writing $file to $dev ..."
    $UNZIP -p "$ZIP" "$file" | dd of="$dev" bs=4M conv=fsync 2>/dev/null
    sync
    got=$(head -c "$size" "$dev" | sha256sum | cut -d' ' -f1)
    [ "$got" = "$sha" ] || abort "verification of $dev failed - system may not boot, flash again"
  done < images.txt
done

sync
rm -rf "$WORK"
ui_print "Update finished. Reboot to system (NVMe)."
exit 0
