<?xml version="1.0" encoding="utf-8"?>
<!-- device/brcm/rpi5/permissions/privapp-permissions-campernavigator.xml -->
<permissions>
    <privapp-permissions package="com.example.campernavigator">
        <!-- Erlaubt der App, die sicheren Systemeinstellungen (Location Mode) zu ändern -->
        <permission name="android.permission.WRITE_SECURE_SETTINGS"/>
        <!-- Erlaubt das Starten beim Booten ohne Verzögerung -->
        <permission name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    </privapp-permissions>
</permissions>