<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <!-- Befreit die App von allen Batterie-Einschränkungen (Doze, App Standby) -->
    <allow-in-power-save package="com.example.campernavigator" />
    <!-- Erlaubt der App, im Hintergrund aktiv zu bleiben, auch wenn das Display aus ist -->
    <allow-in-data-usage-save package="com.example.campernavigator" />
</configuration>