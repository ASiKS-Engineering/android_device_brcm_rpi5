<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <!-- Exempts the app from all battery restrictions (Doze, App Standby) -->
    <allow-in-power-save package="com.example.campernavigator" />
    <!-- Allows the app to stay active in background even when display is off -->
    <allow-in-data-usage-save package="com.example.campernavigator" />
</configuration>