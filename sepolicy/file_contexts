# CEC
/dev/cec0  u:object_r:cec_device:s0
/dev/cec1  u:object_r:cec_device:s0

# DRM
/data/vendor/mediadrm(/.*)?  u:object_r:mediadrm_vendor_data_file:s0

# Hailo
/dev/hailo[0-9]+             u:object_r:hailo_device:s0
/data/vendor/hailo(/.*)?     u:object_r:hailo_data_file:s0
/vendor/bin/hailo_service    u:object_r:hailo_service_exec:s0
/vendor/etc/hailo(/.*)?      u:object_r:hailo_vendor_configs_file:s0

# Graphics
/dev/dri(/.*)?  u:object_r:gpu_device:s0

# Boot order (one-shot tryboot via VideoCore mailbox)
/dev/vcio                    u:object_r:vcio_device:s0
/vendor/bin/set_reboot_order u:object_r:set_reboot_order_exec:s0

# Partitions
/dev/block/mmcblk0p1  u:object_r:boot_block_device:s0
/dev/block/mmcblk0p3  u:object_r:userdata_block_device:s0
/dev/block/mmcblk0p5  u:object_r:system_block_device:s0
/dev/block/mmcblk0p6  u:object_r:system_block_device:s0
/dev/block/mmcblk0p7  u:object_r:metadata_block_device:s0
/dev/block/nvme0n1p1  u:object_r:boot_block_device:s0
/dev/block/nvme0n1p3  u:object_r:userdata_block_device:s0
/dev/block/nvme0n1p5  u:object_r:system_block_device:s0
/dev/block/nvme0n1p6  u:object_r:system_block_device:s0
/dev/block/nvme0n1p7  u:object_r:metadata_block_device:s0
/dev/block/sda1       u:object_r:boot_block_device:s0
/dev/block/sda3       u:object_r:userdata_block_device:s0
/dev/block/sda5       u:object_r:system_block_device:s0
/dev/block/sda6       u:object_r:system_block_device:s0
/dev/block/sda7       u:object_r:metadata_block_device:s0
